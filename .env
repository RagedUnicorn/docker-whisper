# Docker Compose environment variables
# This file sets default values that can be overridden

# whisper image versions
# Use 'latest' / 'latest-cuda' for the most recent versions, or specify a
# version like:
# - 0.5.7-cpu-1
# - 0.5.7-cuda-1
WHISPER_VERSION=latest
WHISPER_CUDA_VERSION=latest-cuda

# Container structure test harness version (used by docker-compose.test.yml).
# Pinned so CI validates against a known harness; Renovate proposes bumps.
# renovate: datasource=docker depName=ragedunicorn/container-test
CONTAINER_STRUCTURE_TEST_VERSION=1.22.1-alpine3.24.1-1
